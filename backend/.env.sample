# Database
DATABASE_URL=postgres://user:password@localhost:5432/budget_tracker?sslmode=disable

# Server
PORT=8080
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug

# SMTP (Email)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=Budget Tracker <your-email@gmail.com>
MAIL_FROM_NAME=Budget Tracker
APP_URL=http://localhost:8080

# FQDN used as the domain part of outbound email Message-ID headers.
# MUST contain at least one dot (RFC 5322 §3.6.4) to avoid Gmail's bulk-mail
# spam heuristics. In production this is typically the public service domain
# (e.g. orgfin); for local dev a fictional FQDN such as
# localhost.localdomain is acceptable. Leave empty to fall back to the
# machine hostname / FQDN-via-CNAME resolution chain.
MESSAGE_ID_DOMAIN=localhost.localdomain

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...
STRIPE_SUCCESS_URL=/payment/success
STRIPE_CANCEL_URL=/payment/cancel

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Exchange Rates API (CurrencyBeacon)
CURRENCYBEACON_API_URL=https://api.currencybeacon.com
CURRENCYBEACON_API_KEY=your-currencybeacon-api-key

# Admin
ADMINS_NOTIFICATION_EMAILS=admin@example.com

# Internal API (for service-to-service calls, e.g., backup notifications)
INTERNAL_API_TOKEN=

# Kubernetes (for backup job trigger; leave empty for auto-detection in-cluster)
K8S_NAMESPACE=

# Redis (required for async task system)
REDIS_URL=redis://localhost:6379

# Worker Configuration
WORKER_ENABLED=true
WORKER_CONCURRENCY=10

# Scheduled Task Cron Expressions
SCHEDULE_EXCHANGE_RATE_UPDATE=0 13 * * *
SCHEDULE_BUDGET_PROCESSING=1 0 * * *
SCHEDULE_TOKEN_CLEANUP=0 2 * * *
SCHEDULE_SUBSCRIPTION_RENEWAL=0 1 * * *
SCHEDULE_SUBSCRIPTION_DOWNGRADE=0 * * * *
